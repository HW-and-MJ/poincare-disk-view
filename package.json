{
  "name": "poincare-disk-view",
  "version": "0.1.5",
  "description": "Obsidian plugin: shows the notes around a focused note on a Poincaré disk with a hyperbolic {p,q} tiling.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test tests/*.test.ts",
    "bump": "node scripts/version.mjs"
  },
  "author": "hyewonnavie and jmj3078",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "obsidian": "^1.14.4",
    "typescript": "~5.9"
  }
}
